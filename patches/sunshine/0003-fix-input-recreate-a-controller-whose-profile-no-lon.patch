From 8ef26a49eaea44389a92af377183db2cc1d76fa0 Mon Sep 17 00:00:00 2001
From: Gunnm92 <gunnm44@gmail.com>
Date: Mon, 23 Nov 2026 02:26:18 +0100
Subject: [PATCH] fix(input): recreate a controller whose profile no longer
 matches its arrival

A virtual gamepad created by the legacy path (controller state packet
received before the arrival packet) gets the default profile (Xbox Series)
without any metadata. Retained input sessions then keep that device across
reconnections: the next arrival only rebinds it, ignoring the reported
type. A DualSense client ends up with an Xbox pad until the session is
torn down, which takes several reconnections.

The gamepad slot now remembers the arrival metadata it was created from.
An arrival on a slot created without metadata, or with another type or
capabilities, frees the device and creates it again from the reported
metadata. An identical arrival still rebinds the retained device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/input.cpp             | 33 ++++++++++++++++++++++++----
 src/input.h               |  3 ++-
 tests/unit/test_input.cpp | 46 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 77 insertions(+), 5 deletions(-)

diff --git a/src/input.cpp b/src/input.cpp
index ad11f29..1e2c477 100644
--- a/src/input.cpp
+++ b/src/input.cpp
@@ -260,6 +260,14 @@ namespace input {
 
     int id {-1};  ///< Global gamepad slot assigned to this client controller, or -1 when unassigned.
 
+    /**
+     * @brief Client-reported metadata the virtual device was created from.
+     *
+     * Empty when the device was created by the legacy path (a controller state packet
+     * received before any arrival packet), whose profile is only a default guess.
+     */
+    std::optional<platf::gamepad_arrival_t> arrival;
+
     // When emulating the HOME button, we may need to artificially release the back button.
     // Afterwards, the gamepad state on sunshine won't match the state on Moonlight.
     // To prevent Sunshine from sending erroneous input data to the active application,
@@ -1393,15 +1401,27 @@ namespace input {
    * @param input Stream input state.
    * @param client_index Client-relative controller index.
    * @param arrival Client-reported controller metadata.
+   * @param reported `false` for the legacy path, where @p arrival is empty and the profile a guess.
    * @return Assigned global gamepad slot, or -1 when allocation fails.
    */
-  int alloc_gamepad(std::shared_ptr<input_t> &input, int client_index, const platf::gamepad_arrival_t &arrival) {
+  int alloc_gamepad(std::shared_ptr<input_t> &input, int client_index, const platf::gamepad_arrival_t &arrival, bool reported = true) {
     if (client_index < 0 || client_index >= input->gamepads.size()) {
       BOOST_LOG(warning) << "ControllerNumber out of range ["sv << client_index << ']';
       return -1;
     }
 
     auto &gamepad = input->gamepads[client_index];
+    // A device created without metadata (state packet ahead of the arrival packet), or
+    // retained from a previous connection with another controller type, would keep the
+    // wrong profile for the whole session (e.g. an Xbox pad for a DualSense client):
+    // recreate it from the reported metadata instead of rebinding it.
+    if (gamepad.id >= 0 && reported &&
+        (!gamepad.arrival || gamepad.arrival->type != arrival.type || gamepad.arrival->capabilities != arrival.capabilities)) {
+      BOOST_LOG(info) << "Recreating controller ["sv << client_index << "] from its arrival metadata"sv
+                      << (gamepad.arrival ? " (controller type changed)"sv : " (created before arrival)"sv);
+      ::input::free_gamepad(platf_input, gamepad.id);
+      gamepad.id = -1;
+    }
     if (gamepad.id >= 0) {
       // Resume-time motion requests can arrive before the client assigns this
       // controller slot. Replay them after its arrival, without recreating the
@@ -1430,6 +1450,11 @@ namespace input {
     }
 
     gamepad.id = id;
+    if (reported) {
+      gamepad.arrival = arrival;
+    } else {
+      gamepad.arrival.reset();
+    }
     return id;
   }
 
@@ -1704,7 +1729,7 @@ namespace input {
     // If this is an event for a new gamepad, create the gamepad now. Ideally, the client would
     // send a controller arrival instead of this but it's still supported for legacy clients.
     if ((packet->activeGamepadMask & (1 << packet->controllerNumber)) && gamepad.id < 0) {
-      if (alloc_gamepad(input, packet->controllerNumber, {}) < 0) {
+      if (alloc_gamepad(input, packet->controllerNumber, {}, false) < 0) {
         return;
       }
     } else if (!(packet->activeGamepadMask & (1 << packet->controllerNumber)) && gamepad.id >= 0) {
@@ -2564,8 +2589,8 @@ namespace input {
       return input->client_context.get();
     }
 
-    int alloc_gamepad(std::shared_ptr<input_t> &input, std::uint8_t client_index, const platf::gamepad_arrival_t &metadata) {
-      return ::input::alloc_gamepad(input, client_index, metadata);
+    int alloc_gamepad(std::shared_ptr<input_t> &input, std::uint8_t client_index, const platf::gamepad_arrival_t &metadata, bool reported) {
+      return ::input::alloc_gamepad(input, client_index, metadata, reported);
     }
 
     int gamepad_id(const std::shared_ptr<input_t> &input, std::uint8_t client_index) {
diff --git a/src/input.h b/src/input.h
index 4c9dd1f..58de5c5 100644
--- a/src/input.h
+++ b/src/input.h
@@ -118,9 +118,10 @@ namespace input {
      * @param input Retained input state.
      * @param client_index Client-relative controller index.
      * @param metadata Client-reported controller metadata.
+     * @param reported `false` to model the legacy path (state packet before any arrival packet).
      * @return Assigned global gamepad slot, or -1 on failure.
      */
-    int alloc_gamepad(std::shared_ptr<input_t> &input, std::uint8_t client_index, const platf::gamepad_arrival_t &metadata);
+    int alloc_gamepad(std::shared_ptr<input_t> &input, std::uint8_t client_index, const platf::gamepad_arrival_t &metadata, bool reported = true);
 
     /**
      * @brief Return the global gamepad slot stored for a test controller.
diff --git a/tests/unit/test_input.cpp b/tests/unit/test_input.cpp
index b9082da..198a72a 100644
--- a/tests/unit/test_input.cpp
+++ b/tests/unit/test_input.cpp
@@ -582,6 +582,52 @@ TEST_F(InputGamepadSessionTest, ReportsMissingRetainedBackendOnArrival) {
   EXPECT_EQ(input::testing::alloc_gamepad(stream_input, 0, metadata), -1);
 }
 
+TEST_F(InputGamepadSessionTest, RecreatesLegacyControllerFromLateArrival) {
+  config::input.gamepad = "auto";
+  auto stream_input = input::alloc(std::make_shared<safe::mail_raw_t>(), "legacy-before-arrival");
+  const auto active_devices = runtime().active_device_count();
+  const auto kind = [&](int id) {
+    const auto *adapter = platf::virtualhid::gamepad_adapter_for_testing(context(), id);
+    return adapter && adapter->gamepad() ? adapter->gamepad()->profile().gamepad_kind : lvh::GamepadProfileKind::generic;
+  };
+
+  // Controller state packet ahead of the arrival packet: default profile.
+  const auto legacy_id = input::testing::alloc_gamepad(stream_input, 0, {}, false);
+  ASSERT_GE(legacy_id, 0);
+  EXPECT_EQ(kind(legacy_id), lvh::GamepadProfileKind::xbox_series);
+
+  const auto id = input::testing::alloc_gamepad(stream_input, 0, {LI_CTYPE_PS, 0, 0});
+  ASSERT_GE(id, 0);
+  EXPECT_EQ(input::testing::gamepad_id(stream_input, 0), id);
+  EXPECT_EQ(kind(id), lvh::GamepadProfileKind::dualsense);
+  EXPECT_EQ(runtime().active_device_count(), active_devices + 1);
+
+  // The same arrival again (resumed connection) keeps the device.
+  const auto *adapter = platf::virtualhid::gamepad_adapter_for_testing(context(), id);
+  EXPECT_EQ(input::testing::alloc_gamepad(stream_input, 0, {LI_CTYPE_PS, 0, 0}), id);
+  EXPECT_EQ(platf::virtualhid::gamepad_adapter_for_testing(context(), id), adapter);
+  EXPECT_EQ(runtime().active_device_count(), active_devices + 1);
+}
+
+TEST_F(InputGamepadSessionTest, RecreatesRetainedControllerWhenTypeChanges) {
+  config::input.gamepad = "auto";
+  const std::string session_id = "retained-type-change";
+  auto first = input::alloc(std::make_shared<safe::mail_raw_t>(), session_id);
+  const auto xbox_id = input::testing::alloc_gamepad(first, 0, {LI_CTYPE_XBOX, 0, 0});
+  ASSERT_GE(xbox_id, 0);
+  const auto active_devices = runtime().active_device_count();
+  first.reset();
+
+  auto resumed = input::alloc(std::make_shared<safe::mail_raw_t>(), session_id);
+  const auto id = input::testing::alloc_gamepad(resumed, 0, {LI_CTYPE_PS, 0, 0});
+  ASSERT_GE(id, 0);
+  const auto *adapter = platf::virtualhid::gamepad_adapter_for_testing(context(), id);
+  ASSERT_NE(adapter, nullptr);
+  ASSERT_NE(adapter->gamepad(), nullptr);
+  EXPECT_EQ(adapter->gamepad()->profile().gamepad_kind, lvh::GamepadProfileKind::dualsense);
+  EXPECT_EQ(runtime().active_device_count(), active_devices);
+}
+
 TEST_F(InputGamepadSessionTest, RefreshesSharedVirtualInputAfterLicenseStateChanges) {
   ASSERT_NE(context().keyboard, nullptr);
   ASSERT_NE(context().mouse, nullptr);
-- 
