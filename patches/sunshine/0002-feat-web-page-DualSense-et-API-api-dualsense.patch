+  /**
+   * @brief Get the DualSense haptics settings and the libvirtualhid driver status.
+   * @param response HTTP response used for authentication and output.
+   * @param request Authenticated HTTP request.
+   *
+   * @api_examples{/api/dualsense|:| GET|:| null}
+   */
+  void getDualsense(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) {
+      return;
+    }
+
+    print_req(request);
+    send_response(response, dualsense::get_state());
+  }
+
+  /**
+   * @brief Save the DualSense haptics settings (gain and channel count) to the settings file.
+   * @param response HTTP response used for authentication, CSRF, validation and output.
+   * @param request HTTP request carrying the JSON body {"gain": F, "channels": 2|4}.
+   *
+   * @api_examples{/api/dualsense|:| POST|:| {"gain":1.5,"channels":4}}
+   */
+  void saveDualsense(const resp_https_t &response, const req_https_t &request) {
+    if (!check_content_type(response, request, "application/json")) {
+      return;
+    }
+    if (!authenticate(response, request)) {
+      return;
+    }
+
+    std::string client_id = get_client_id(request);
+    if (!validate_csrf_token(response, request, client_id)) {
+      return;
+    }
+
+    print_req(request);
+
+    std::stringstream ss;
+    ss << request->content.rdbuf();
+    std::string error;
+    const auto settings = dualsense::save_settings(ss.str(), error);
+    if (!settings) {
+      bad_request(response, error);
+      return;
+    }
+
+    nlohmann::json output_tree;
+    output_tree["status"] = true;
+    output_tree["settings"] = *settings;
+    send_response(response, output_tree);
+  }
+
   /**
    * @brief Get the current libvirtualhid machine license status.
    *
@@ -2606,6 +2660,8 @@ namespace confighttp {
