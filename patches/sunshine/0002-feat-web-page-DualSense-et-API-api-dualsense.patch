+          <dt class="col-sm-4">{{ $t('dualsense.destination') }}</dt>
+          <dd class="col-sm-8">{{ status.destination || $t('dualsense.no_destination') }}</dd>
+          <dt class="col-sm-4">{{ $t('dualsense.channels') }}</dt>
+          <dd class="col-sm-8">{{ status.channels ?? '-' }}</dd>
+          <dt class="col-sm-4">{{ $t('dualsense.gain') }}</dt>
+          <dd class="col-sm-8">{{ status.gain !== undefined ? Number(status.gain).toFixed(2) : '-' }}</dd>
+          <dt class="col-sm-4">{{ $t('dualsense.packets') }}</dt>
+          <dd class="col-sm-8 mb-0">{{ status.packets ?? '-' }}</dd>
+        </dl>
+      </div>
+    </div>
+
+    <div class="card mb-4">
+      <div class="card-body">
+        <h2 class="h5">{{ $t('dualsense.level') }}</h2>
+        <div v-for="(level, index) in levels" :key="index" class="d-flex align-items-center gap-3 mb-2">
+          <span class="dualsense-level-label">{{ $t(levelLabels[index]) }}</span>
+          <div class="progress flex-grow-1" role="meter" :aria-label="$t(levelLabels[index])"
+               :aria-valuemin="-60" :aria-valuemax="0" :aria-valuenow="Math.max(-60, Math.min(0, level.db))">
+            <div class="progress-bar" :style="{width: level.percent + '%'}"></div>
+          </div>
+          <span class="dualsense-level-db text-end">{{ level.db > -120 ? level.db.toFixed(1) + ' dB' : '-' }}</span>
+        </div>
+      </div>
