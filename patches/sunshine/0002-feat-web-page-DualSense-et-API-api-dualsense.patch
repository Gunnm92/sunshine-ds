+<template>
+  <Navbar></Navbar>
+  <div id="content" class="container">
+    <h1 class="my-4">{{ $t('dualsense.title') }}</h1>
+    <p class="text-body-secondary">{{ $t('dualsense.intro') }}</p>
+
+    <div class="card mb-4">
