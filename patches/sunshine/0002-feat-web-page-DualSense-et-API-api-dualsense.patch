diff --git a/src/dualsense_settings.cpp b/src/dualsense_settings.cpp
index ae429a6..a2a89f7 100644
--- a/src/dualsense_settings.cpp
+++ b/src/dualsense_settings.cpp
@@ -1,11 +1,15 @@
 /**
  * @file src/dualsense_settings.cpp
- * @brief Startup environment of the DualSense haptics files (libvirtualhid).
+ * @brief Settings file, status file and startup environment for the DualSense haptics (libvirtualhid).
  */
 // standard includes
+#include <charconv>
 #include <filesystem>
-#include <string>
+#include <format>
+#include <fstream>
+#include <sstream>
 #include <string_view>
+#include <system_error>
 
 // lib includes
 #include <lizardbyte/common/env.h>
@@ -21,10 +25,162 @@ namespace dualsense {
 
     constexpr auto settings_env = "LIBVIRTUALHID_DUALSENSE_SETTINGS"sv;  ///< Settings file read by the driver.
     constexpr auto status_env = "LIBVIRTUALHID_DUALSENSE_STATUS"sv;  ///< Status file written by the driver.
+    constexpr auto channels_env = "LIBVIRTUALHID_DUALSENSE_RTP_CHANNELS"sv;  ///< Default channel count (2 or 4).
+    constexpr double gain_default = 1.0;  ///< Gain used when the settings file has none.
+    constexpr double gain_max = 64.0;  ///< Upper bound of the driver gain (exclusive lower bound 0).
+
+    /**
+     * @brief Haptics settings: gain (0 < gain <= 64) and channel count (2 or 4).
+     */
+    struct settings_t {
+      double gain {gain_default};  ///< Haptics gain.
+      int channels {2};  ///< 2 = haptics only, 4 = speaker + haptics.
+    };
+
+    bool valid_gain(double gain) {
+      return gain > 0.0 && gain <= gain_max;
+    }
+
+    bool valid_channels(int channels) {
+      return channels == 2 || channels == 4;
+    }
 
     std::string env_value(std::string_view name) {
       return lizardbyte::common::get_env(std::string {name});
     }
+
+    std::optional<std::string> read_text(const std::string &path) {
+      if (path.empty()) {
+        return std::nullopt;
+      }
+      std::ifstream in {path, std::ios::binary};
+      if (!in) {
+        return std::nullopt;
+      }
+      std::ostringstream buffer;
+      buffer << in.rdbuf();
+      return buffer.str();
+    }
+
+    std::string_view trim(std::string_view text) {
+      const auto first = text.find_first_not_of(" \t\r\n");
+      if (first == std::string_view::npos) {
+        return {};
+      }
+      const auto last = text.find_last_not_of(" \t\r\n");
+      return text.substr(first, last - first + 1);
+    }
+
+    /**
+     * @brief Defaults used when the settings file is missing or a key is invalid.
+     */
+    settings_t default_settings() {
+      settings_t settings;
+      int channels = 0;
+      const auto text = env_value(channels_env);
+      const auto [end, ec] = std::from_chars(text.data(), text.data() + text.size(), channels);
+      if (ec == std::errc {} && end == text.data() + text.size() && valid_channels(channels)) {
+        settings.channels = channels;
+      }
+      return settings;
+    }
+
+    /**
+     * @brief Read key=value lines ('#' comments) from the settings file, falling back to defaults per key.
+     */
+    settings_t read_settings() {
+      auto settings = default_settings();
+      const auto text = read_text(env_value(settings_env));
+      if (!text) {
+        return settings;
+      }
+
+      std::istringstream lines {*text};
+      std::string raw;
+      while (std::getline(lines, raw)) {
+        const auto line = trim(raw);
+        if (line.empty() || line.front() == '#') {
+          continue;
+        }
+        const auto eq = line.find('=');
+        if (eq == std::string_view::npos) {
+          continue;
+        }
+        const auto key = trim(line.substr(0, eq));
+        const auto value = trim(line.substr(eq + 1));
+
+        if (key == "gain"sv) {
+          double gain = 0.0;
+          const auto [end, ec] = std::from_chars(value.data(), value.data() + value.size(), gain);
+          if (ec == std::errc {} && end == value.data() + value.size() && valid_gain(gain)) {
+            settings.gain = gain;
+          }
+        } else if (key == "channels"sv) {
+          int channels = 0;
+          const auto [end, ec] = std::from_chars(value.data(), value.data() + value.size(), channels);
+          if (ec == std::errc {} && end == value.data() + value.size() && valid_channels(channels)) {
+            settings.channels = channels;
+          }
+        }
+      }
+      return settings;
+    }
+
+    /**
+     * @brief Settings file content, in the key=value form read by libvirtualhid.
+     */
+    std::string render_settings(const settings_t &settings) {
+      return std::format(
+        "# Sunshine DualSense haptics settings (Web UI page DualSense).\n"
+        "# gain: haptics gain, reloaded by the driver every second (0 < gain <= 64).\n"
+        "# channels: 2 = haptics only, 4 = speaker + haptics, applied at the next connection.\n"
+        "gain={}\n"
+        "channels={}\n",
+        settings.gain,
+        settings.channels
+      );
+    }
+
+    /**
+     * @brief Write a file through a temporary sibling and rename it over the target.
+     */
+    bool write_atomic(const std::string &path, const std::string &content, std::string &error) {
+      const auto target = std::filesystem::path {path};
+      const auto temporary = std::filesystem::path {path + ".tmp"};
+      {
+        std::ofstream out {temporary, std::ios::binary | std::ios::trunc};
+        out << content;
+        out.flush();
+        if (!out) {
+          error = "Cannot write the DualSense settings file";
+          std::error_code ec;
+          std::filesystem::remove(temporary, ec);
+          return false;
+        }
+      }
+
+      std::error_code ec;
+      std::filesystem::rename(temporary, target, ec);
+      if (ec) {
+        error = "Cannot replace the DualSense settings file: "s + ec.message();
+        std::filesystem::remove(temporary, ec);
+        return false;
+      }
+      return true;
+    }
+
+    /**
+     * @brief Driver status file content, or {"attached": false} when absent or unreadable.
+     */
+    nlohmann::json read_status() {
+      const auto fallback = nlohmann::json {{"attached", false}};
+      const auto text = read_text(env_value(status_env));
+      if (!text) {
+        return fallback;
+      }
+      auto status = nlohmann::json::parse(*text, nullptr, false);
+      return status.is_object() ? status : fallback;
+    }
   }  // namespace
 
   void init_environment(const std::string &config_file) {
@@ -42,4 +198,57 @@ namespace dualsense {
     }
   }
 
+  nlohmann::json get_state() {
+    const auto settings = read_settings();
+
+    nlohmann::json state;
+    state["settings"] = {{"gain", settings.gain}, {"channels", settings.channels}};
+    state["status"] = read_status();
+    return state;
+  }
+
+  std::optional<nlohmann::json> save_settings(const std::string &body, std::string &error) {
+    const auto request = nlohmann::json::parse(body, nullptr, false);
+    if (request.is_discarded() || !request.is_object()) {
+      error = "Invalid JSON body";
+      return std::nullopt;
+    }
+
+    const auto gain_it = request.find("gain");
+    if (gain_it == request.end() || !gain_it->is_number()) {
+      error = "gain must be a number";
+      return std::nullopt;
+    }
+    settings_t settings;
+    settings.gain = gain_it->get<double>();
+    if (!valid_gain(settings.gain)) {
+      error = "gain must be greater than 0 and at most 64";
+      return std::nullopt;
+    }
+
+    const auto channels_it = request.find("channels");
+    if (channels_it == request.end() || !channels_it->is_number_integer()) {
+      error = "channels must be 2 or 4";
+      return std::nullopt;
+    }
+    settings.channels = channels_it->get<int>();
+    if (!valid_channels(settings.channels)) {
+      error = "channels must be 2 or 4";
+      return std::nullopt;
+    }
+
+    const auto path = env_value(settings_env);
+    if (path.empty()) {
+      error = "LIBVIRTUALHID_DUALSENSE_SETTINGS is not set";
+      return std::nullopt;
+    }
+    if (!write_atomic(path, render_settings(settings), error)) {
+      BOOST_LOG(warning) << "DualSense settings: "sv << error;
+      return std::nullopt;
+    }
+
+    BOOST_LOG(info) << "DualSense settings saved: gain="sv << settings.gain << " channels="sv << settings.channels;
+    return nlohmann::json {{"gain", settings.gain}, {"channels", settings.channels}};
+  }
+
 }  // namespace dualsense
