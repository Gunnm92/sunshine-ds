+        </div>
+        <div class="mb-3">
+          <label for="dualsense-gain" class="form-label d-flex justify-content-between">
+            <span>{{ $t('dualsense.gain') }}</span>
+            <output for="dualsense-gain">{{ Number(form.gain).toFixed(2) }}</output>
+          </label>
+          <input id="dualsense-gain" v-model.number="form.gain" type="range" class="form-range"
+                 min="0" max="4" step="0.05">
+          <div class="form-text">{{ $t('dualsense.gain_note') }}</div>
+        </div>
+        <button type="submit" class="btn btn-primary" :disabled="saving">
+          <save :size="18" class="icon"></save>
+          {{ $t('dualsense.save') }}
+        </button>
+        <div v-if="message" :class="`alert alert-${message.type} mt-3 mb-0`" role="alert">{{ message.text }}</div>
+      </div>
+    </form>
+  </div>
+</template>
+
+<script>
+  import Navbar from './Navbar.vue'
+  import { apiFetch } from './fetch_utils'
+  import { Gamepad2, Save } from '@lucide/vue'
+
+  /** Driver peak meter floor and ceiling, in dB. */
+  const METER_MIN_DB = -60
+
+  export default {
+    components: {
+      Navbar,
+      Gamepad2,
+      Save,
+    },
+    inject: ['i18n'],
+    data() {
+      return {
+        status: {attached: false},
+        form: {channels: 2, gain: 1},
+        formLoaded: false,
+        levels: [0, 1, 2, 3].map(() => ({db: -120, percent: 0})),
+        levelLabels: [
+          'dualsense.level_speaker_left',
+          'dualsense.level_speaker_right',
+          'dualsense.level_haptics_left',
+          'dualsense.level_haptics_right',
+        ],
+        loadError: false,
+        message: null,
+        pollTimer: null,
+        saving: false,
+      };
+    },
+    computed: {
+      attached() {
+        return this.status.attached === true;
+      },
+    },
+    mounted() {
+      this.load();
+      this.pollTimer = window.setInterval(() => this.load(), 1000);
+    },
+    beforeUnmount() {
+      window.clearInterval(this.pollTimer);
+    },
+    methods: {
+      /**
+       * Refresh the driver status and, on first load, the saved settings.
+       */
+      async load() {
+        try {
+          const response = await apiFetch('./api/dualsense', {method: 'GET'});
+          if (!response.ok) {
+            throw new Error(`HTTP ${response.status}`);
+          }
+
+          const body = await response.json();
+          this.loadError = false;
+          this.status = body.status || {attached: false};
+          if (!this.formLoaded && body.settings) {
+            this.form = {channels: body.settings.channels, gain: body.settings.gain};
+            this.formLoaded = true;
+          }
+          this.updateLevels(this.status.peak_db);
+        } catch (error) {
+          console.error('Failed to load DualSense status', error);
+          this.loadError = true;
+        }
+      },
+
+      /**
+       * Map the four peak values (dB, -120 = silence) onto the meter scale.
+       */
+      updateLevels(peaks) {
+        if (!Array.isArray(peaks)) {
+          this.levels = [0, 1, 2, 3].map(() => ({db: -120, percent: 0}));
+          return;
+        }
+        this.levels = [0, 1, 2, 3].map((index) => {
+          const db = Number.isFinite(peaks[index]) ? peaks[index] : -120;
+          const percent = Math.max(0, Math.min(1, (db - METER_MIN_DB) / -METER_MIN_DB)) * 100;
+          return {db, percent};
+        });
+      },
+
+      /**
+       * Save channels and gain; the driver applies the gain live and the channels at the next connection.
+       */
+      async save() {
+        this.saving = true;
+        this.message = null;
+        try {
+          const response = await apiFetch('./api/dualsense', {
+            method: 'POST',
+            headers: {'Content-Type': 'application/json'},
+            body: JSON.stringify({
+              gain: Number(this.form.gain),
+              channels: Number(this.form.channels),
+            }),
+          });
+          const result = await response.json();
+          if (response.ok && result.status === true) {
+            this.form = {channels: result.settings.channels, gain: result.settings.gain};
+            this.message = {type: 'success', text: this.i18n.t('dualsense.saved')};
+          } else {
+            this.message = {type: 'danger', text: `${this.i18n.t('dualsense.save_failure')} ${result.error || ''}`.trim()};
+          }
+        } catch (error) {
+          console.error('Failed to save DualSense settings', error);
+          this.message = {type: 'danger', text: this.i18n.t('dualsense.save_failure')};
+        } finally {
+          this.saving = false;
+        }
+      },
+    },
+  }
+</script>
+
+<style scoped>
+  .dualsense-level-label {
+    min-width: 9rem;
+  }
+
+  .dualsense-level-db {
+    min-width: 4.5rem;
+    font-variant-numeric: tabular-nums;
+  }
+</style>
