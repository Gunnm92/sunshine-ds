diff --git a/src/platform/virtualhid_input.cpp b/src/platform/virtualhid_input.cpp
index 854c796..db19ada 100644
--- a/src/platform/virtualhid_input.cpp
+++ b/src/platform/virtualhid_input.cpp
@@ -6,6 +6,7 @@
 // standard includes
 #include <algorithm>
 #include <array>
+#include <charconv>
 #include <cmath>
 #include <cstddef>
 #include <cstdint>
@@ -15,7 +16,9 @@
 #include <numbers>
 #include <optional>
 #include <random>
+#include <string>
 #include <string_view>
+#include <system_error>
 #include <utility>
 
 // lib includes
@@ -247,6 +250,89 @@ namespace platf::virtualhid {
       return std::format("02:00:00:00:00:{:02x}", id.globalIndex);
     }
 
+    /**
+     * @brief Default UDP port of the DualSense haptics RTP stream on the client.
+     */
+    constexpr std::uint16_t haptics_default_port = 46100;
+
+    /**
+     * @brief Check that a string is a dotted-quad IPv4 address (a.b.c.d, each part 0-255).
+     */
+    bool is_dotted_ipv4(std::string_view text) {
+      int groups = 0;
+      int value = -1;
+      int digits = 0;
+      for (const char c : text) {
+        if (c == '.') {
+          if (value < 0 || ++groups > 3) {
+            return false;
+          }
+          value = -1;
+          digits = 0;
+        } else if (c >= '0' && c <= '9') {
+          value = (value < 0 ? 0 : value) * 10 + (c - '0');
+          if (++digits > 3 || value > 255) {
+            return false;
+          }
+        } else {
+          return false;
+        }
+      }
+      return value >= 0 && groups == 3;
+    }
+
+    /**
+     * @brief IPv4 host of a client address, or an empty string.
+     * @details An IPv4-mapped IPv6 address (::ffff:a.b.c.d) yields a.b.c.d; any other IPv6 address yields nothing.
+     */
+    std::string haptics_ipv4_host(std::string address) {
+      constexpr std::string_view mapped_prefix {"::ffff:"};
+      if (address.starts_with(mapped_prefix)) {
+        address.erase(0, mapped_prefix.size());
+      }
+      return is_dotted_ipv4(address) ? address : std::string {};
+    }
+
+    /**
+     * @brief UDP port of the haptics stream: LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT, or 46100.
+     */
+    std::uint16_t haptics_port() {
+      const auto value = lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT");
+      if (value.empty()) {
+        return haptics_default_port;
+      }
+
+      std::uint32_t port = 0;
+      const auto [end, ec] = std::from_chars(value.data(), value.data() + value.size(), port);
+      if (ec == std::errc {} && end == value.data() + value.size() && port >= 1 && port <= 65535) {
+        return static_cast<std::uint16_t>(port);
+      }
+
+      BOOST_LOG(warning) << "Invalid LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT ["sv << value << "], using "sv << haptics_default_port;
+      return haptics_default_port;
+    }
+
+    /**
+     * @brief Haptics destination ("ip:port") for the Moonlight client of the session.
+     * @details An explicit LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP keeps priority: nothing is set and the driver reads it.
+     * @return Destination, or an empty string when the driver should use its own default.
+     */
+    std::string haptics_destination(const std::string &client_address) {
+      if (!lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP").empty()) {
+        return {};
+      }
+
+      const auto host = haptics_ipv4_host(client_address);
+      if (host.empty()) {
+        BOOST_LOG(info) << "DualSense haptics: no IPv4 client address ["sv << client_address << "], the driver default applies"sv;
+        return {};
+      }
+
+      auto destination = std::format("{}:{}", host, haptics_port());
+      BOOST_LOG(info) << "DualSense haptics destination: "sv << destination << " (Moonlight client)"sv;
+      return destination;
+    }
+
     lvh::GamepadMetadata gamepad_metadata(const gamepad_id_t &id, const gamepad_arrival_t &metadata, const lvh::DeviceProfile &profile) {
       lvh::GamepadMetadata result;
       result.global_index = id.globalIndex;
@@ -257,6 +343,9 @@ namespace platf::virtualhid {
       result.has_rgb_led = metadata.capabilities & LI_CCAP_RGB_LED;
       result.has_battery = metadata.capabilities & LI_CCAP_BATTERY_STATE;
       result.stable_id = gamepad_stable_id(id, profile);
+      if (profile.gamepad_kind == lvh::GamepadProfileKind::dualsense) {
+        result.haptics_destination = haptics_destination(metadata.client_address);
+      }
       return result;
     }
 
