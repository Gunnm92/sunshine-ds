+/**
+ * @file src/dualsense_settings.h
+ * @brief DualSense haptics settings and status files shared with libvirtualhid, and the haptics destination.
+ */
+#pragma once
+
+// standard includes
+#include <string>
+
+namespace dualsense {
+
+  /**
+   * @brief Point the libvirtualhid settings and status files into the Sunshine config directory.
+   * @details Sets LIBVIRTUALHID_DUALSENSE_SETTINGS and LIBVIRTUALHID_DUALSENSE_STATUS when they are unset or empty.
+   * Call before any gamepad is created.
+   *
+   * @param config_file Path of the active sunshine.conf; its directory is the config directory.
+   */
+  void init_environment(const std::string &config_file);
+
+  /**
+   * @brief Haptics RTP destination ("ip:port") for the Moonlight client of the session.
+   * @details The port is LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT, or 46100. An IPv4-mapped IPv6 address
+   * yields its IPv4 form. An explicit LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP keeps priority.
+   *
+   * @param client_address Client IP address of the session.
+   * @return Destination, or an empty string when the driver should use its own default
+   * (explicit destination set, or no IPv4 client address).
+   */
+  std::string haptics_destination(const std::string &client_address);
+
+}  // namespace dualsense
