+/**
+ * @file src/dualsense_settings.cpp
+ * @brief Startup environment of the DualSense haptics files (libvirtualhid) and haptics destination.
+ */
+// standard includes
+#include <charconv>
+#include <cstdint>
+#include <filesystem>
+#include <format>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <system_error>
+
+// lib includes
+#include <boost/asio/ip/address.hpp>
+#include <lizardbyte/common/env.h>
+
+// local includes
+#include "dualsense_settings.h"
+#include "logging.h"
+#include "network.h"
+
+namespace dualsense {
+
+  namespace {
+    using namespace std::literals;
+
+    constexpr auto settings_env = "LIBVIRTUALHID_DUALSENSE_SETTINGS"sv;  ///< Settings file read by the driver.
+    constexpr auto status_env = "LIBVIRTUALHID_DUALSENSE_STATUS"sv;  ///< Status file written by the driver.
+    constexpr auto haptics_rtp_env = "LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP"sv;  ///< Explicit destination, read by the driver.
+    constexpr auto haptics_port_env = "LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT"sv;  ///< UDP port of the client.
+    constexpr std::uint16_t haptics_default_port = 46100;  ///< UDP port of the client by default.
+
+    std::string env_value(std::string_view name) {
+      return lizardbyte::common::get_env(std::string {name});
+    }
+
+    /**
+     * @brief Parse a whole string as a number, without leading spaces or trailing characters.
+     */
+    template<typename T>
+    std::optional<T> parse_number(std::string_view text) {
+      T value {};
+      const auto [end, ec] = std::from_chars(text.data(), text.data() + text.size(), value);
+      if (ec != std::errc {} || end != text.data() + text.size()) {
+        return std::nullopt;
+      }
+      return value;
+    }
+
+    std::uint16_t haptics_port() {
+      const auto text = env_value(haptics_port_env);
+      if (text.empty()) {
+        return haptics_default_port;
+      }
+      if (const auto port = parse_number<std::uint16_t>(text); port && *port != 0) {
+        return *port;
+      }
+      BOOST_LOG(warning) << "Invalid "sv << haptics_port_env << " ["sv << text << "], using "sv << haptics_default_port;
+      return haptics_default_port;
+    }
+  }  // namespace
+
+  void init_environment(const std::string &config_file) {
+    const auto directory = std::filesystem::path {config_file}.parent_path();
+
+    if (env_value(settings_env).empty()) {
+      const auto path = (directory / "dualsense.conf").string();
+      lizardbyte::common::set_env(std::string {settings_env}, path);
+      BOOST_LOG(info) << "DualSense settings file: "sv << path;
+    }
+    if (env_value(status_env).empty()) {
+      const auto path = (directory / "dualsense-status.json").string();
+      lizardbyte::common::set_env(std::string {status_env}, path);
+      BOOST_LOG(info) << "DualSense status file: "sv << path;
+    }
+  }
+
+  std::string haptics_destination(const std::string &client_address) {
+    if (!env_value(haptics_rtp_env).empty()) {
+      return {};
+    }
+
+    boost::system::error_code ec;
+    const auto address = net::normalize_address(boost::asio::ip::make_address(client_address, ec));
+    if (ec || !address.is_v4()) {
+      BOOST_LOG(info) << "DualSense haptics: no IPv4 client address ["sv << client_address << "], the driver default applies"sv;
+      return {};
+    }
+
+    auto destination = std::format("{}:{}", address.to_string(), haptics_port());
+    BOOST_LOG(info) << "DualSense haptics destination: "sv << destination << " (Moonlight client)"sv;
+    return destination;
+  }
+
+}  // namespace dualsense
