--- /dev/null
+++ b/tests/unit/test_dualsense_settings.cpp
@@ -0,0 +1,104 @@
+/**
+ * @file tests/unit/test_dualsense_settings.cpp
+ * @brief Test src/dualsense_settings.*
+ */
+
+// test includes
+#include "../tests_common.h"
+
+// standard includes
+#include <array>
+#include <filesystem>
+#include <optional>
+#include <string>
+
+// lib includes
+#include <lizardbyte/common/env.h>
+
+// local includes
+#include <src/dualsense_settings.h>
+
+namespace {
+
+  /**
+   * @brief Restore the DualSense environment variables touched by a test.
+   */
+  class DualsenseSettingsTest: public ::testing::Test {
+  protected:
+    static constexpr std::array names {
+      "LIBVIRTUALHID_DUALSENSE_SETTINGS",
+      "LIBVIRTUALHID_DUALSENSE_STATUS",
+      "LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP",
+      "LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT",
+    };
+
+    void SetUp() override {
+      for (std::size_t i = 0; i < names.size(); ++i) {
+        std::string value;
+        if (lizardbyte::common::get_env(names[i], value)) {
+          saved_[i] = value;
+        }
+        lizardbyte::common::unset_env(names[i]);
+      }
+    }
+
+    void TearDown() override {
+      for (std::size_t i = 0; i < names.size(); ++i) {
+        if (saved_[i]) {
+          lizardbyte::common::set_env(names[i], *saved_[i]);
+        } else {
+          lizardbyte::common::unset_env(names[i]);
+        }
+      }
+    }
+
+  private:
+    std::array<std::optional<std::string>, names.size()> saved_ {};
+  };
+
+}  // namespace
+
+TEST_F(DualsenseSettingsTest, InitEnvironmentPointsUnsetFilesIntoTheConfigDirectory) {
+  const std::filesystem::path directory {"config"};
+  dualsense::init_environment((directory / "sunshine.conf").string());
+
+  EXPECT_EQ(lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_SETTINGS"), (directory / "dualsense.conf").string());
+  EXPECT_EQ(lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_STATUS"), (directory / "dualsense-status.json").string());
+}
+
+TEST_F(DualsenseSettingsTest, InitEnvironmentKeepsExplicitFiles) {
+  const std::filesystem::path directory {"config"};
+  lizardbyte::common::set_env("LIBVIRTUALHID_DUALSENSE_SETTINGS", "custom.conf");
+
+  dualsense::init_environment((directory / "sunshine.conf").string());
+
+  EXPECT_EQ(lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_SETTINGS"), "custom.conf");
+  EXPECT_EQ(lizardbyte::common::get_env("LIBVIRTUALHID_DUALSENSE_STATUS"), (directory / "dualsense-status.json").string());
+}
+
+TEST_F(DualsenseSettingsTest, HapticsDestinationUsesTheIpv4ClientAddress) {
+  EXPECT_EQ(dualsense::haptics_destination("10.10.10.1"), "10.10.10.1:46100");
+  EXPECT_EQ(dualsense::haptics_destination("::ffff:10.10.10.1"), "10.10.10.1:46100");
+}
+
+TEST_F(DualsenseSettingsTest, HapticsDestinationLeavesOtherAddressesToTheDriver) {
+  for (const auto *address : {"", "fe80::1", "2001:db8::1", "10.10.10", "10.10.10.256", "host.lan"}) {
+    EXPECT_EQ(dualsense::haptics_destination(address), "") << address;
+  }
+}
+
+TEST_F(DualsenseSettingsTest, HapticsDestinationUsesAValidPortOverride) {
+  lizardbyte::common::set_env("LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT", "47000");
+  EXPECT_EQ(dualsense::haptics_destination("10.10.10.1"), "10.10.10.1:47000");
+
+  for (const auto *port : {"0", "65536", "-1", "47000x", " 47000"}) {
+    lizardbyte::common::set_env("LIBVIRTUALHID_DUALSENSE_HAPTICS_PORT", port);
+    EXPECT_EQ(dualsense::haptics_destination("10.10.10.1"), "10.10.10.1:46100") << port;
+  }
+}
+
+TEST_F(DualsenseSettingsTest, HapticsDestinationDefersToAnExplicitDestination) {
+  lizardbyte::common::set_env("LIBVIRTUALHID_DUALSENSE_HAPTICS_RTP", "192.0.2.5:5000");
+
+  EXPECT_EQ(dualsense::haptics_destination("10.10.10.1"), "");
+}
